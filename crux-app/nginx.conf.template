server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # gzip 圧縮
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    # バックエンド API へのプロキシ（ローカルの Vite proxy と同じ挙動）
    # BACKEND_URL 環境変数で接続先を切り替え（ローカル: host.docker.internal:8000 / AWS: ALB DNS名）
    # resolver を指定することで nginx が起動時ではなくリクエストのたびに DNS 再解決を行う。
    # AWS VPC の DNS リゾルバー (169.254.169.253) を使用し、TTL を 30 秒に設定。
    # ALB の IP ローテーションに追従するために必要。
    resolver 169.254.169.253 valid=30s ipv6=off;

    location /api/ {
        set $backend_url http://${BACKEND_URL};
        proxy_pass $backend_url;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA: すべてのルートを index.html にフォールバック
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 静的アセットのキャッシュ
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
